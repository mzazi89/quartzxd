# ── QUARTZ XD — environment ────────────────────────────────────────────────
# Neon PostgreSQL connection string — the SAME database shared by
# mzazi89/web, mzazi89/admin and mzazi89/quartz (bot_status + bot_control).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Public site URL (used in metadata / OG tags)
NEXT_PUBLIC_BASE_URL=https://quartzxd.example.com

# OPTIONAL — protect the Delete button with a pin. When set, deleting a device
# requires this exact pin (the UI prompts for it). Leave empty for open delete.
DELETE_PIN=
